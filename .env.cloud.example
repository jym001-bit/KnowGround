# Copy to .env.cloud on the server. Never commit the filled file.
# This is a template for Docker Compose env_file, not for the IDE's local .env loader.
SPRING_PROFILES_ACTIVE=docker,prod
APP_TIMEZONE=Asia/Shanghai
SERVER_PORT=8081

# Use Docker service names, never localhost, for container-to-container traffic.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/smart?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=smart
SPRING_DATASOURCE_PASSWORD=CHANGE_ME
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=CHANGE_ME
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_TOPIC_PARTITIONS=1
SPRING_KAFKA_TOPIC_REPLICATION_FACTOR=1

MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=CHANGE_ME_PUBLIC_MINIO_URL
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=uploads
ELASTICSEARCH_HOST=es
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME
ELASTICSEARCH_INSECURE_TRUST_ALL_CERTIFICATES=false

JWT_SECRET_KEY=CHANGE_ME_BASE64_32_RANDOM_BYTES
ADMIN_BOOTSTRAP_ENABLED=false
APP_AUTH_REGISTRATION_MODE=OPEN
APP_AUTH_INVITE_REQUIRED=false

# 公网试运行额度：新用户一次性赠送，以及每人每日上限
USAGE_QUOTA_USE_USER_TOKEN_BALANCE=true
USAGE_QUOTA_CHAT_DAY_MAX_REQUESTS=10
USAGE_QUOTA_LLM_INIT_TOKENS=20000
USAGE_QUOTA_LLM_DAY_MAX_TOKENS=10000
USAGE_QUOTA_EMBEDDING_INIT_TOKENS=10000
USAGE_QUOTA_EMBEDDING_DAY_MAX_TOKENS=3000
SECURITY_ALLOWED_ORIGINS=CHANGE_ME_HTTPS_SITE_ORIGIN
KNOWLEDGE_BOOTSTRAP_ENABLED=false
LOG_LEVEL_APP=INFO

DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=CHANGE_ME
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_DIMENSION=2048

# PDF upload requires LiteParse's `lit` executable inside the backend image.
FILE_PARSING_PDF_ENGINE=liteparse
FILE_PARSING_LITEPARSE_COMMAND=lit
FILE_PARSING_LITEPARSE_OCR_ENABLED=false
ALIYUN_OCR_ENABLED=false
WX_PAY_ENABLE=false
