server:
  address: 'tcp://0.0.0.0:9091/authelia'

authentication_backend:
  password_reset:
    disable: true
  file:
    path: '/config/users.yml'

access_control:
  default_policy: 'deny'
  rules:
    - domain: 'jymcode.top'
      policy: 'one_factor'
      subject:
        - 'user:admin'

session:
  secret: '__SESSION_SECRET__'
  cookies:
    - name: 'authelia_session'
      domain: 'jymcode.top'
      authelia_url: 'https://jymcode.top/authelia/'
      default_redirection_url: 'https://jymcode.top/server/'
      inactivity: '15m'
      expiration: '2h'
      remember_me: '0'

regulation:
  max_retries: 3
  find_time: '5m'
  ban_time: '15m'

storage:
  encryption_key: '__STORAGE_SECRET__'
  local:
    path: '/config/db.sqlite3'

notifier:
  filesystem:
    filename: '/config/notification.txt'
