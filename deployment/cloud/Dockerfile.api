FROM node:22-trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --global --no-audit --no-fund @llamaindex/liteparse@2.0.0

WORKDIR /app
RUN mkdir -p /app/logs && chown node:node /app/logs
COPY --chown=node:node target/SmartPAI-0.0.1-SNAPSHOT.jar /app/app.jar
USER node
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
