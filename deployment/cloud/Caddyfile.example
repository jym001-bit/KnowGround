{
    default_sni 23.252.124.29
}

http://23.252.124.29 {
    handle /.well-known/acme-challenge/* {
        root * /opt/knowground/acme-webroot
        file_server
    }
    handle {
        redir https://23.252.124.29{uri} 308
    }
}
# The direct IP entry is separate from the domain sites.
https://23.252.124.29 {
    tls /etc/caddy/ip-cert/fullchain.pem /etc/caddy/ip-cert/privkey.pem
    encode zstd gzip

    handle /api/* {
        route {
            @private_api path /api/v1/test/* /api/v1/internal/ocr/*
            respond @private_api "Not Found" 404
            reverse_proxy 127.0.0.1:18081
        }
    }

    handle /proxy-ws/* {
        uri strip_prefix /proxy-ws
        reverse_proxy 127.0.0.1:18081
    }

    handle /rag/uploads/* {
        route {
            @non_read not method GET HEAD
            respond @non_read "Method Not Allowed" 405
            uri strip_prefix /rag
            reverse_proxy 127.0.0.1:19000 {
                header_up Host rustfs:9000
            }
        }
    }

    handle /uploads/* {
        route {
            @non_read not method GET HEAD
            respond @non_read "Method Not Allowed" 405
            reverse_proxy 127.0.0.1:19000 {
                header_up Host rustfs:9000
            }
        }
    }

    handle {
        root * /opt/knowground/frontend/dist
        try_files {path} /index.html
        file_server
    }
}

# The apex domain leaves other paths available for future projects.
jymcode.top {
    encode zstd gzip

    @authelia path /authelia /authelia/*
    handle @authelia {
        reverse_proxy 127.0.0.1:9091
    }

    handle /server/monitor/* {
        route {
            request_header -Remote-User
            request_header -Remote-Email
            request_header -X-Beszel-Identity
            request_header -Authorization
            forward_auth 127.0.0.1:9091 {
                uri /api/authz/forward-auth?authelia_url=https://jymcode.top/authelia/
                copy_headers Remote-User Remote-Email
            }
            @anonymous not header Remote-User *
            respond @anonymous "Forbidden" 403
            @foreign_origin {
                header Origin *
                not header Origin https://jymcode.top
            }
            respond @foreign_origin "Forbidden" 403
            uri strip_prefix /server/monitor
            header X-Frame-Options SAMEORIGIN
            reverse_proxy 127.0.0.1:8090 {
                header_up -Cookie
                header_up -Authorization
                header_up X-Beszel-Identity {http.request.header.Remote-Email}
                header_down -X-Frame-Options
                header_down Content-Security-Policy "(?i)frame-ancestors[[:space:]]+[^;]*(;|$)" "frame-ancestors 'self';"
            }
        }
    }

    handle /server/* {
        route {
            request_header -Remote-User
            request_header -Remote-Email
            forward_auth 127.0.0.1:9091 {
                uri /api/authz/forward-auth?authelia_url=https://jymcode.top/authelia/
                copy_headers Remote-User Remote-Email
            }
            @anonymous not header Remote-User *
            respond @anonymous "Forbidden" 403
            @foreign_origin {
                header Origin *
                not header Origin https://jymcode.top
            }
            respond @foreign_origin "Forbidden" 403
            reverse_proxy unix//run/server-console/http.sock
        }
    }
    handle {
        error 404
    }

    handle_errors {
        @not_found expression {err.status_code} == 404
        handle @not_found {
            root * /opt/knowground/error-pages
            rewrite * /404.html
            file_server
        }
        handle {
            respond "{err.status_code} {err.status_text}"
        }
    }
}

# KnowGround lives on its own hostname; jymcode.top keeps the server console only.
knowground.jymcode.top {
    encode zstd gzip

    handle /api/* {
        route {
            @private_api path /api/v1/test/* /api/v1/internal/ocr/*
            respond @private_api "Not Found" 404
            reverse_proxy 127.0.0.1:18081
        }
    }

    handle /proxy-ws/* {
        uri strip_prefix /proxy-ws
        reverse_proxy 127.0.0.1:18081
    }

    handle /uploads/* {
        route {
            @non_read not method GET HEAD
            respond @non_read "Method Not Allowed" 405
            reverse_proxy 127.0.0.1:19000 {
                header_up Host rustfs:9000
            }
        }
    }

    handle {
        root * /opt/knowground/frontend/dist-knowground
        try_files {path} /index.html
        file_server
    }
}
